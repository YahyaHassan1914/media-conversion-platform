{
  "compilerOptions": {
    // JavaScript version emitted by TypeScript
    // ES2022 is well-supported by modern Node.js versions
    "target": "ES2022",

    // Use Node.js native ESM/CommonJS behavior
    // Works together with "type": "module" in package.json
    "module": "NodeNext",

    // Resolve imports the same way Node.js does
    "moduleResolution": "NodeNext",

    // Source TypeScript files location
    "rootDir": "./src",

    // Compiled JavaScript output location
    "outDir": "./dist",

    // Include Node.js type definitions
    // Requires: npm install -D @types/node
    "types": ["node"],

    // Enable all strict type-checking options
    "strict": true,

    // Array/object access may return undefined
    // Example: users[0] -> User | undefined
    "noUncheckedIndexedAccess": true,

    // Optional properties must be handled explicitly
    // Provides stricter behavior for interfaces and types
    "exactOptionalPropertyTypes": true,

    // Preserve import/export statements exactly as written
    // Encourages proper use of `import type`
    "verbatimModuleSyntax": true,

    // Ensures each file can be transpiled independently
    // Required by many modern tools such as tsx, esbuild, and SWC
    "isolatedModules": true,

    // Generate source maps for easier debugging
    // Allows stack traces to point to .ts files instead of .js files
    "sourceMap": true,

    // Skip type checking of declaration files in node_modules
    // Improves build performance
    "skipLibCheck": true
  },

  // Only compile files inside the src directory
  "include": ["src"]
}
